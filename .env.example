# OpenLedgerApp environment variables. Copy to `.env.local` (untracked) for local runs.
# Anything starting with VITE_ is built into the browser bundle and is PUBLIC.
# Hosted builds get their public values from wrangler.jsonc (per environment) and their
# secrets from Worker secrets. Never commit real secret values (docs/SHARED-SPEC.md §7).

# --- Public: Supabase project (publishable key only) ---
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable key>
VITE_SUPABASE_PROJECT_ID=<your-project-ref>
# Same values for server-side rendering (read through process.env on the Worker)
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable key>

# --- Public: suite settings (SHARED-SPEC §1.1, §7.1) ---
# true = OpenAppHub hosted build (sign-in, orgs, members, billing in the hub). Default false = self-hosted.
VITE_HOSTED=false
VITE_APP_ID=ledger
VITE_APP_SCHEMA=ledger
# Hosted only: hub address, shared cookie domain, other apps (JSON of app -> URL)
VITE_HUB_URL=
VITE_COOKIE_DOMAIN=
VITE_SUITE_URLS=
# Help links; defaults to https://docs.openapphub.org
VITE_DOCS_URL=

# --- Secret, server only (Worker secret; never VITE_) ---
# Signs backups so edited files are refused on restore. 64+ random characters
# (e.g. `openssl rand -hex 32`); keep it stable: changing it makes old backups "from another install".
BACKUP_SIGNING_SEED=<random secret>
# SELF-HOSTED ONLY. Hosted Ledger uses no service-role key (SHARED-SPEC §7.2).
# Needed by self-hosted account deletion, invite claim and restore until steps 5-10 move them to core functions.
SUPABASE_SERVICE_ROLE_KEY=<service-role key - server only>
# Legacy, being removed: AI-assisted PDF import through the Lovable AI gateway.
# Owner decision: PDF import is off until a provider is chosen (MIGRATION-NOTES step 3b).
LOVABLE_API_KEY=

# --- Development only ---
# Desktop builds set VITE_EDITION=desktop through the tracked .env.desktop (public, no keys).
# Leave unset in production
# VITE_ALLOW_DEMO_LOGIN=true

# --- GitHub Actions secrets (not used by the app; listed so nothing is missed) ---
# PROD_DATABASE_URL, STAGING_DATABASE_URL   Supabase Session pooler strings (port 5432)
# SUPABASE_ACCESS_TOKEN, PROD_REF, STAGING_REF
# (No Cloudflare secrets: the hosted edition deploys through Cloudflare's Git integration.)
